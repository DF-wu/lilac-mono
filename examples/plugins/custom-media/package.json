{
  "name": "custom-media",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "lilac": {
    "plugin": "./dist/index.js"
  },
  "scripts": {
    "build": "mkdir -p dist && bun build ./src/index.ts --target=bun --format=esm --packages=bundle --minify --outfile=./dist/index.js && bun -e 'const p=\"dist/index.js\"; await Bun.write(p, (await Bun.file(p).text()).replace(/[ \\t]+$/gm, \"\"))'",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "fmt": "bunx oxfmt --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.json\"",
    "fmt:check": "bunx oxfmt --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.json\""
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.7",
    "ai": "7.0.22",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "oxfmt": "0.44.0",
    "typescript": "7.0.2"
  }
}
